  "description": "nextDesk-Netzwerkagent: Discovery (Ping, ARP, SNMP, LLDP) und Microsoft DHCP/DNS für die IP-Adressverwaltung.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
