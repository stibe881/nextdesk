{
  "name": "@nextdesk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build && node scripts/spa-fallback.mjs",
    "build:hetzner": "vite build --mode hetzner && node scripts/spa-fallback.mjs",
    "build:pages": "vite build --mode github-pages",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nextdesk/config": "workspace:*",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^1.57.0",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.12",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
